# Basis URL Laravel API (lihat src/lib/api.ts).
# Salin berkas ini menjadi .env lalu sesuaikan nilainya.
#
# Dev lokal (php artisan serve): http://127.0.0.1:8000/api/v1
# Produksi: URL backend Laravel yang sudah di-deploy, mis.
#   VITE_API_URL=https://api.domain-anda.com/api/v1
VITE_API_URL=http://127.0.0.1:8000/api/v1
